# API base URL — update this when backend is hosted
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Server-side only API URL (used in Server Components, generateMetadata, sitemap)
# Never exposed to the browser. Same value as above until you have a separate internal URL.
API_BASE_URL=http://localhost:5000/api/v1

# Public site URL — used for sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://ssherbalindia.com
